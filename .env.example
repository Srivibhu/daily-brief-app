# JWT secret — generate any random string (openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Google OAuth — from Google Cloud Console → APIs & Services → Credentials
# Client ID is public (used in the browser); Client Secret is server-only.
# The redirect flow (mobile) also needs GOOGLE_CLIENT_SECRET.
# In Google Cloud Console, add this to "Authorised redirect URIs":
#   https://your-domain.com/api/auth/google-callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Set to your deployed domain (used to build the OAuth redirect URI)
NEXT_PUBLIC_APP_URL=https://your-domain.com
